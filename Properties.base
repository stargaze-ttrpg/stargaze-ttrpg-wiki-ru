filters:
  and:
    - file.inFolder("Items/Properties")
views:
  - type: table
    name: Table
    order:
      - file.name
      - type
      - subtype
      - class_owner
      - class_level
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: type
        direction: DESC
